{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": ["pack.ts", "texts.ts", "gamedata/configs/**/*.ts"],
  "exclude": ["node_modules", "gamedata/scripts"]
}
